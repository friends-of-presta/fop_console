{
  "name": "friends-of-presta/fop_console",
  "description": "Add some console commands for PrestaShop 1.7.5+",
  "authors": [
    {
      "name": "Friends of Presta",
      "email": "infos@friendsofpresta.org",
      "homepage": "https://friendsofpresta.org/"
    }
  ],
  "autoload": {
    "psr-4": {
      "FOP\\Console\\": "src/"
    },
    "classmap": [".devtools/"]
  },
  "autoload-dev": {
    "psr-4": {
      "FOP\\Console\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^7.2.5 || ^8.0",
    "laminas/laminas-code": "^3.5.1 || ^4.0",
    "ext-json": "*",
    "nette/php-generator": "^3.6.9 || ^4.0",
    "pbergman/tree-helper": "^1.0"
  },
  "config": {
    "prepend-autoloader": false,
    "allow-plugins": {
      "phpro/grumphp": true
    }
  },
  "license": "AFL-3.0",
  "type": "prestashop-module",
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "prestashop/php-dev-tools": "^5.0",
    "phpro/grumphp": "^0.19.1 || ^1.15 || ^2.0",
    "phpstan/phpstan": "1.*",
    "phpunit/phpunit": "^7.0 || ^10.5"
  },
  "scripts": {
    "fop_check": [
      "grumphp run --ansi"
    ]
  }
}
