{
  "name": "friends-of-presta/fop_console",
  "description": "Add console commands for PrestaShop 9.1+",
  "authors": [
    {
      "name": "Friends of Presta",
      "email": "infos@friendsofpresta.org",
      "homepage": "https://friendsofpresta.org/"
    }
  ],
  "autoload": {
    "psr-4": {
      "FOP\\Console\\": "src/"
    },
    "classmap": [".devtools/"]
  },
  "autoload-dev": {
    "psr-4": {
      "FOP\\Console\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.1",
    "laminas/laminas-code": "^4.16",
    "ext-json": "*",
    "nette/php-generator": "^4.1",
    "pbergman/tree-helper": "^1.0"
  },
  "config": {
    "platform": {
      "php": "8.1.0"
    },
    "prepend-autoloader": false,
    "allow-plugins": {
      "phpro/grumphp": true
    }
  },
  "license": "AFL-3.0",
  "type": "prestashop-module",
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "prestashop/php-dev-tools": "^5.0",
    "phpro/grumphp": "^2.0",
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^10.5",
    "symfony/yaml": "^6.4"
  },
  "scripts": {
    "fop_check": [
      "grumphp run --ansi"
    ]
  }
}
